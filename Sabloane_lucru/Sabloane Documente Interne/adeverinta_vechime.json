{
  "title": "Adeverință de Vechime",
  "order": 7,
  "template_file": "Adeverinta_Vechime.docx",
  "registratura": true,
  "registratura_date_field": "DataInreg",
  "registratura_tip_doc_pk": 3,
  "sections": [
    {
      "title": "DATE ADEVERINȚĂ",
      "height": 82,
      "fields": [
        {
          "key": "DataInreg",
          "label": "Data adeverinței",
          "type": "date",
          "label_width_percent": 34,
          "required": true
        },
        {
          "key": "NumeIntocmitorHr",
          "label": "Întocmit de (HR)",
          "type": "text",
          "label_width_percent": 33,
          "default": "Marin Iulia Alina"
        },
        {
          "key": "NumeDirectorEconomic",
          "label": "Director economic",
          "type": "text",
          "label_width_percent": 33,
          "default": "Dunea Dorica"
        }
      ]
    },
    {
      "title": "CARTE DE IDENTITATE",
      "height": 82,
      "fields": [
        {
          "key": "SerieCI",
          "label": "Seria CI",
          "type": "text",
          "label_width_percent": 20
        },
        {
          "key": "NrCI",
          "label": "Număr CI",
          "type": "text",
          "label_width_percent": 20
        },
        {
          "key": "AutoritateEmitenta",
          "label": "Autoritatea emitentă",
          "type": "text",
          "label_width_percent": 35,
          "default": "SPCLEP Botosani"
        },
        {
          "key": "DataEliberareCI",
          "label": "Data eliberării CI",
          "type": "date",
          "label_width_percent": 25,
          "required": true
        }
      ]
    },
    {
      "title": "CONTRACT DE MUNCĂ",
      "height": 82,
      "fields": [
        {
          "key": "TipNorma",
          "label": "Tip normă",
          "type": "combo",
          "label_width_percent": 50,
          "options": [
            "intreaga",
            "partiala"
          ]
        },
        {
          "key": "TipDurataContract",
          "label": "Durata contractului",
          "type": "combo",
          "label_width_percent": 50,
          "options": [
            "nedeterminata",
            "determinata"
          ]
        }
      ]
    },
    {
      "title": "MUTAȚII INTERVENITE",
      "height": 300,
      "fields": [
        {
          "key": "Mutatii",
          "label": "Mutații intervenite",
          "type": "dynamic_list",
          "edit_mode": "dialog",
          "dialog_title": "Mutație intervenită",
          "initial_items": [
            {
              "TipMutatie": "Incheiere Contract",
              "DataMutatie": "{DataCim}",
              "FunctieCurenta": "{Functie}",
              "TipDoc": "Contract",
              "NrInregistrareDoc": "{NrCim}",
              "DataInregDoc": "{DataCim}"
            }
          ],
          "required": true,
          "item_fields": [
            {
              "key": "TipMutatie",
              "label": "Tip mutație",
              "type": "combo",
              "width_percent": 50,
              "options": [
                "Incheiere Contract",
                "Modificare Contract",
                "Suspendare Contract",
                "Incetare Contract"
              ],
              "default": "Modificare Contract",
              "on_select": {
                "Incheiere Contract": {
                  "TipDoc": "Contract",
                  "FunctieCurenta": "{Functie}",
                  "DataMutatie": "{DataCim}",
                  "NrInregistrareDoc": "{NrCim}",
                  "DataInregDoc": "{DataCim}"
                },
                "Modificare Contract": {
                  "TipDoc": "Act aditional",
                  "FunctieCurenta": "{Functie}"
                },
                "Suspendare Contract": {
                  "TipDoc": "Decizie",
                  "FunctieCurenta": "{Functie}"
                },
                "Incetare Contract": {
                  "TipDoc": "Decizie",
                  "FunctieCurenta": "{Functie}"
                }
              },
              "group": "Mutația"
            },
            {
              "key": "DataMutatie",
              "label": "Data mutației",
              "type": "date",
              "width_percent": 50,
              "maps": {
                "AnulMutatie": "yyyy",
                "LunaMutatie": "MM",
                "ZiMutatie": "dd"
              }
            },
            {
              "key": "FunctieCurenta",
              "label": "Meseria / Funcția la data mutației",
              "type": "text",
              "width_percent": 100
            },
            {
              "key": "SalariulDeBaza",
              "label": "Salariul de bază (Lei)",
              "type": "number",
              "width_percent": 35,
              "max": 99999,
              "decimals": 2,
              "format": "#,##0.##",
              "group": "Salariu"
            },
            {
              "key": "DetaliuSporOptional",
              "label": "Spor",
              "type": "check_text",
              "width_percent": 65,
              "check_label": "Are spor"
            },
            {
              "key": "TipDoc",
              "label": "Tip act",
              "type": "combo",
              "width_percent": 40,
              "options": [
                "Contract",
                "Act aditional",
                "Decizie",
                "Notificare",
                "Cerere",
                "Referat"
              ],
              "group": "Actul care atestă mutația"
            },
            {
              "key": "NrInregistrareDoc",
              "label": "Nr. înregistrare act",
              "type": "text",
              "width_percent": 30
            },
            {
              "key": "DataInregDoc",
              "label": "Data actului",
              "type": "date",
              "width_percent": 30
            },
            {
              "key": "DetaliiTemeiLegalOptional",
              "label": "Temei legal",
              "type": "check_text",
              "width_percent": 100,
              "check_label": "Are temei legal"
            }
          ],
          "hide_header": true,
          "add_button_label": "Adaugă mutație",
          "auto_height": true,
          "max_height": 560,
          "summary_fields": [
            "TipMutatie",
            "DataMutatie",
            "FunctieCurenta"
          ]
        }
      ]
    },
    {
      "title": "PARAGRAFE FINALE (Da = se completează; Nu = linii punctate în document)",
      "height": 82,
      "fields": [
        {
          "key": "ParagrafIncetareContractOptional",
          "label": "Încetare contract",
          "type": "combo",
          "label_width_percent": 25,
          "options": [
            "Nu",
            "Da"
          ]
        },
        {
          "key": "ParagrafPerioadaAbsenteNemotivateOptional",
          "label": "Absențe nemotivate",
          "type": "combo",
          "label_width_percent": 25,
          "options": [
            "Nu",
            "Da"
          ]
        },
        {
          "key": "ParagrafPerioadaConcediuFaraPlataOptional",
          "label": "Concediu fără plată",
          "type": "combo",
          "label_width_percent": 25,
          "options": [
            "Nu",
            "Da"
          ]
        },
        {
          "key": "ParagrafPerioadaIncapacitateTemporaraOptional",
          "label": "Incapacitate temporară",
          "type": "combo",
          "label_width_percent": 25,
          "options": [
            "Nu",
            "Da"
          ]
        }
      ]
    },
    {
      "title": "ÎNCETARE CONTRACT",
      "height": 82,
      "fields": [
        {
          "key": "DataIncetareContract",
          "label": "Data încetării contractului",
          "type": "date",
          "label_width_percent": 35
        },
        {
          "key": "PrevederiLegale",
          "label": "Prevederi legale",
          "type": "text",
          "default": "Art. 81 alin. 7 din Legea nr. 53/2003",
          "label_width_percent": 65
        }
      ],
      "depends_on": "ParagrafIncetareContractOptional",
      "depends_value": "Da"
    },
    {
      "title": "ABSENȚE NEMOTIVATE",
      "height": 170,
      "fields": [
        {
          "key": "PerioadeAbsenteNemotivate",
          "label": "Perioade absențe nemotivate",
          "type": "dynamic_list",
          "initial_rows": 1,
          "item_fields": [
            {
              "key": "Perioada",
              "label": "Perioadă (de la – până la)",
              "type": "date_range",
              "width_percent": 100
            }
          ],
          "hide_header": true,
          "auto_height": true,
          "max_height": 320,
          "add_button_label": "Adaugă perioadă"
        }
      ],
      "depends_on": "ParagrafPerioadaAbsenteNemotivateOptional",
      "depends_value": "Da"
    },
    {
      "title": "CONCEDIU FĂRĂ PLATĂ",
      "height": 170,
      "fields": [
        {
          "key": "PerioadeConcediuFaraPlata",
          "label": "Perioade concediu fără plată",
          "type": "dynamic_list",
          "initial_rows": 1,
          "item_fields": [
            {
              "key": "Perioada",
              "label": "Perioadă (de la – până la)",
              "type": "date_range",
              "width_percent": 100
            }
          ],
          "hide_header": true,
          "auto_height": true,
          "max_height": 320,
          "add_button_label": "Adaugă perioadă"
        }
      ],
      "depends_on": "ParagrafPerioadaConcediuFaraPlataOptional",
      "depends_value": "Da"
    },
    {
      "title": "INCAPACITATE TEMPORARĂ DE MUNCĂ",
      "height": 170,
      "fields": [
        {
          "key": "PerioadeIncapacitateTemporara",
          "label": "Perioade incapacitate temporară",
          "type": "dynamic_list",
          "initial_rows": 1,
          "item_fields": [
            {
              "key": "Perioada",
              "label": "Perioadă (de la – până la)",
              "type": "date_range",
              "width_percent": 100
            }
          ],
          "hide_header": true,
          "auto_height": true,
          "max_height": 320,
          "add_button_label": "Adaugă perioadă"
        }
      ],
      "depends_on": "ParagrafPerioadaIncapacitateTemporaraOptional",
      "depends_value": "Da"
    }
  ],
  "hooks": [
    {
      "on": "on_generate",
      "handler": "ConcatList",
      "params": {
        "source_field": "PerioadeAbsenteNemotivate",
        "item_key": "Perioada",
        "target_field": "PerioadaAbsenteNemotivateOptional",
        "separator": " si in perioada "
      }
    },
    {
      "on": "on_generate",
      "handler": "ConcatList",
      "params": {
        "source_field": "PerioadeConcediuFaraPlata",
        "item_key": "Perioada",
        "target_field": "PerioadaConediuFaraPlataOptional",
        "separator": " si in perioada "
      }
    },
    {
      "on": "on_generate",
      "handler": "ConcatList",
      "params": {
        "source_field": "PerioadeIncapacitateTemporara",
        "item_key": "Perioada",
        "target_field": "PerioadaIncapacitateTemporaraOptional",
        "separator": " si in perioada "
      }
    },
    {
      "on": "on_generate",
      "handler": "BlankIfNotEquals",
      "params": {
        "source_field": "ParagrafIncetareContractOptional",
        "equals": "Da",
        "target_field": "DataIncetareContract",
        "blank": "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _"
      }
    },
    {
      "on": "on_generate",
      "handler": "BlankIfNotEquals",
      "params": {
        "source_field": "ParagrafIncetareContractOptional",
        "equals": "Da",
        "target_field": "PrevederiLegale",
        "blank": "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _"
      }
    },
    {
      "on": "on_generate",
      "handler": "BlankIfNotEquals",
      "params": {
        "source_field": "ParagrafPerioadaAbsenteNemotivateOptional",
        "equals": "Da",
        "target_field": "PerioadaAbsenteNemotivateOptional",
        "blank": "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _"
      }
    },
    {
      "on": "on_generate",
      "handler": "BlankIfNotEquals",
      "params": {
        "source_field": "ParagrafPerioadaConcediuFaraPlataOptional",
        "equals": "Da",
        "target_field": "PerioadaConediuFaraPlataOptional",
        "blank": "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _"
      }
    },
    {
      "on": "on_generate",
      "handler": "BlankIfNotEquals",
      "params": {
        "source_field": "ParagrafPerioadaIncapacitateTemporaraOptional",
        "equals": "Da",
        "target_field": "PerioadaIncapacitateTemporaraOptional",
        "blank": "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _"
      }
    }
  ]
}
